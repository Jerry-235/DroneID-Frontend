# Copy to .env (gitignored) and uncomment only what you need. Real environment
# variables win over this file. Values shown are the defaults.

# DRONEID_ZMQ_ADDR=tcp://127.0.0.1:4224
# DRONEID_BT_ZMQ_ADDR=tcp://127.0.0.1:4222
# DRONEID_WIFI_ZMQ_ADDR=tcp://127.0.0.1:4223
# DRONEID_HEALTH_TIMEOUT_S=12
# DRONEID_STALE_AFTER_S=45
# DRONEID_DROP_AFTER_S=105
# DRONEID_FLIGHT_MERGE_WINDOW_S=300
# DRONEID_SOURCE_RECENT_S=15
# DRONEID_BROADCAST_TIMEOUT_S=5

# Remote stations (see MULTI-NODE.md)
# DRONEID_NODES_PATH=nodes.json
# DRONEID_NODE_STATUS_STALE_S=60

# Who may use admin-only endpoints (comma-separated networks)
# DRONEID_ADMIN_NETS=100.64.0.0/10,fd7a:115c:a1e0::/48,127.0.0.0/8,::1/128
# Only if a proxy overwrites X-Forwarded-For
# DRONEID_TRUST_FORWARDED_FOR=

# Discord alerts (leave the webhook blank to turn them off)
DRONEID_DISCORD_WEBHOOK=
# DRONEID_DISCORD_ROLE_ID=

# Place names for alerts
# DRONEID_LANDMARKS_PATH=
# DRONEID_LANDMARK_RADIUS_M=150
# DRONEID_NOMINATIM_URL=https://nominatim.openstreetmap.org/reverse
# DRONEID_GEOCODER_CONTACT=
# DRONEID_PLACE_TIMEOUT_S=2

# Storage and listening address
# DRONEID_DB_PATH=droneid.db
# HOST=0.0.0.0
# PORT=8000
